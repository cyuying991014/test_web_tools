{
  "name": "test-web-tools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "deploy": "npm run build:pages && gh-pages -d dist",
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --base=/test_web_tools/",
    "preview": "vite preview",
    "test:json-find": "node scripts/verify-json-find.mjs",
    "test:json-replace": "node scripts/verify-json-replace.mjs",
    "test:url-parser": "node scripts/verify-url-parser.mjs",
    "test:activation-code": "node scripts/verify-activation-code.mjs",
    "test:cron": "node scripts/verify-cron.mjs",
    "test:regex": "node scripts/verify-regex-debugger.mjs",
    "test:temperature": "node scripts/verify-temperature-converter.mjs",
    "test:data-generator": "node scripts/verify-data-generator-core.mjs && node scripts/verify-data-generator-exporters.mjs && node scripts/verify-data-generator-page.mjs && node scripts/verify-data-generator-ui.mjs"
  },
  "dependencies": {
    "cronosjs": "^1.7.1",
    "cronstrue": "^3.24.0",
    "diff": "^7.0.0",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "jsdom": "^26.0.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1"
  }
}
